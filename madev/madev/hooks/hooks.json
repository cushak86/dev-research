{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/discipline-reminder.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-anchor.sh\""
          }
        ]
      }
    ]
  }
}
