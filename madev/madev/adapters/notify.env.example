# notify.sh 설정 템플릿 — 이 파일을 adapters/notify.env 로 복사하고 값을 채우세요.
#
#   cp adapters/notify.env.example adapters/notify.env
#
# 비워 두거나 파일이 없으면 알림은 조용히 스킵됩니다(fail-open — 회사 운영엔 영향 없음).
# 이 파일은 `. source` 되지 않고 URL 한 줄만 literal 로 파싱됩니다.
# https discord 웹훅만 허용됩니다(https://discord.com/api/webhooks/...).

DISCORD_WEBHOOK_URL=
